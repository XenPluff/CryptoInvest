{
  "name": "aureon",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev -H 0.0.0.0 -p 3000",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "build": "node scripts/generate-client.mjs && next build && tsc -p tsconfig.server.json",
    "start": "concurrently -k -n api,web \"npm:start:api\" \"npm:start:web\"",
    "start:render": "node scripts/start-render.mjs",
    "start:web": "next start -H 0.0.0.0 -p 3000",
    "start:api": "node --env-file=.env dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "videos:render": "tsx scripts/render-videos.mts",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "admin:promote": "tsx --env-file=.env scripts/promote-admin.ts",
    "backup:verify-restore": "tsx scripts/restore-backup.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "next": "15.5.28",
    "nodemailer": "^10.1.7",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.1",
    "undici": "^7.30.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@prisma/internals": "^6.19.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "concurrently": "^9.2.1",
    "jsqr": "^1.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "deepmerge-ts": "^8.0.1"
  }
}
