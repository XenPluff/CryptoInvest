# Production template. Local development: npm run setup:local creates private random values.
# Replace every REPLACE_* value. Never commit the populated .env.
NODE_ENV=production
APP_ORIGIN=https://your-domain.example
PORT=4000
# Internal API port takes priority over PORT. Render uses PORT=3000 for the website.
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
# Count only your actual trusted proxy chain. Leave unset until configured.
# TRUST_PROXY_HOPS=2
# Optional egress proxy and an approved PEM CA file mounted at runtime.
# HTTPS_PROXY=http://your-proxy.example:8080
# HTTP_PROXY=http://your-proxy.example:8080
# NO_PROXY=localhost,127.0.0.1,db
# NODE_EXTRA_CA_CERTS=/run/secrets/environment-ca.pem
# Keep TLS certificate verification enabled. Never store proxy credentials here.

# Compose derives its internal DATABASE_URL from POSTGRES_* below.
# Use independent random hex passwords to avoid URL escaping ambiguity.
POSTGRES_USER=aureon
POSTGRES_DB=aureon
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_BYTE_HEX
DATABASE_URL=postgresql://aureon:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/aureon?schema=public
JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_48_BYTE_HEX
# Exactly 32 random bytes, encoded as 64 hexadecimal characters or base64.
KYC_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_HEX
AUTH_COOKIE=aureon_session
FUNDING_ENABLED=false

# Account mail provider: brevo, resend, smtp, or none. Blank selects an available provider.
# Brevo HTTPS supports the owner-supplied Gmail sender after Brevo sender verification
# and transactional account activation. Brevo rewrites free-domain sender addresses.
EMAIL_PROVIDER=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=aurreon.support@gmail.com
# Resend alternative: register and verify your domain first.
# This sender is configurable; no public mailbox or domain is provisioned.
RESEND_API_KEY=
EMAIL_FROM="Aureon <accounts@your-domain.example>"
# Optional SMTP fallback. Both credentials must be supplied together.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Deposits use the six supplied wallet addresses in the database, seeded by db:seed.
# No external deposit-provider credentials are required.

# Provide ADMIN_EMAIL / ADMIN_PASSWORD / optional ADMIN_NAME securely only when
# running npm run admin:create. No default administrator is provisioned.
# npm run test:integration creates/drops its own disposable database using the
# nonproduction DATABASE_URL role (requires CREATEDB); application data is preserved.
# For direct integration test runs only, TEST_DATABASE_URL must reference a
# disposable database ending in _test. Direct runs reset that test database's schema.
# E2E_BASE_URL=http://localhost:3000
# E2E_MAILPIT_URL=http://127.0.0.1:8025
# CHROMIUM_PATH=/usr/bin/chromium
