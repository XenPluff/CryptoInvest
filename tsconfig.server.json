{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "server/**/*.ts",
    "lib/investment.ts",
    "prisma/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "tests"]
}
